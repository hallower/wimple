<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="kr.blogspot.charlie0301"
    android:versionCode="3"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="14"
        android:targetSdkVersion="17" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme" >
        <activity
            android:name="kr.blogspot.charlie0301.SplashScreenActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/title_activity_splash_screen"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.NoTitleBar" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="kr.blogspot.charlie0301.WebViewActivity"
            android:label="@string/title_activity_web_view" >
        </activity>
        <activity
            android:name="kr.blogspot.charlie0301.TransactionInsertFragment"
            android:configChanges="orientation|screenSize"
            android:label="@string/title_transaction_insert_fragment" >
        </activity>
        <activity
            android:name="kr.blogspot.charlie0301.TransactionListFragment"
            android:configChanges="orientation|screenSize"
            android:label="@string/title_transaction_list_fragment" >
        </activity>
        <activity
            android:name="kr.blogspot.charlie0301.SettingsFragment"
            android:label="@string/title_settings_fragment" >
        </activity>
        <activity
            android:name="kr.blogspot.charlie0301.WimpleActivity"
            android:configChanges="orientation|screenSize"
            android:label="@string/title_activity_wimple" >
        </activity>
        <activity
            android:name="kr.blogspot.charlie0301.PaymentNoticeActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/title_activity_payment_notice"
            android:theme="@style/FullscreenTheme" >
        </activity>
    </application>

</manifest>