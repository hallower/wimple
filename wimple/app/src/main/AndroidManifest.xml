<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:exported="true"
            android:name="kr.blogspot.charlie0301.wimple.SplashScreenActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/title_activity_splash_screen"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="kr.blogspot.charlie0301.wimple.WimpleActivity"
            android:configChanges="orientation|screenSize"
            android:label="@string/title_activity_splash_screen"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar"></activity>
        <activity
            android:name="kr.blogspot.charlie0301.wimple.PaymentNoticeActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/title_activity_payment_notice"
            android:theme="@style/FullscreenTheme"></activity>
        <activity
            android:exported="true"
            android:name="kr.blogspot.charlie0301.wimple.PostNewsActivity"
            android:label="@string/title_activity_post_news">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/*" />
                <data android:mimeType="plain/*" />
            </intent-filter>
        </activity>
        <activity
            android:name="kr.blogspot.charlie0301.wimple.BankNotificationListActivity"
            android:label="@string/bank_noti_list_title"
            android:parentActivityName="kr.blogspot.charlie0301.wimple.WimpleActivity"
            android:theme="@style/AppTheme.NoActionBar" />

        <service
            android:name="kr.blogspot.charlie0301.wimple.BankNotificationListener"
            android:exported="true"
            android:label="@string/bank_noti_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>