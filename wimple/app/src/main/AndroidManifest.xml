<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Foldable continuity hint. Without this, Samsung One UI letterboxes
             the app into cover-screen dimensions (≈411dp wide on Z Fold 7) on
             the unfolded main display, defeating the sw600dp resource qualifier
             that drives the two-pane layout. The flag tells the framework we
             handle size changes correctly so it lets us use the full ~750dp
             unfolded width. -->
        <meta-data
            android:name="android.supports_size_changes"
            android:value="true" />
        <activity
            android:exported="true"
            android:name="kr.blogspot.charlie0301.wimple.SplashScreenActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/title_activity_splash_screen"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="kr.blogspot.charlie0301.wimple.WimpleActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:label="@string/title_activity_splash_screen"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar"></activity>
        <activity
            android:name="kr.blogspot.charlie0301.wimple.PaymentNoticeActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/title_activity_payment_notice"
            android:theme="@style/FullscreenTheme"></activity>
        <activity
            android:exported="true"
            android:name="kr.blogspot.charlie0301.wimple.PostNewsActivity"
            android:label="@string/title_activity_post_news">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/*" />
                <data android:mimeType="plain/*" />
            </intent-filter>
        </activity>
        <activity
            android:name="kr.blogspot.charlie0301.wimple.BankNotificationListActivity"
            android:label="@string/bank_noti_list_title"
            android:parentActivityName="kr.blogspot.charlie0301.wimple.WimpleActivity"
            android:theme="@style/AppTheme.NoActionBar.Tinted" />
        <activity
            android:name="kr.blogspot.charlie0301.wimple.UnsupportedBankNotificationListActivity"
            android:label="@string/bank_noti_unsupported_title"
            android:parentActivityName="kr.blogspot.charlie0301.wimple.WimpleActivity"
            android:theme="@style/AppTheme.NoActionBar.Tinted" />
        <activity
            android:name="kr.blogspot.charlie0301.wimple.BankAppPickerActivity"
            android:label="@string/bank_noti_picker_title"
            android:parentActivityName="kr.blogspot.charlie0301.wimple.WimpleActivity"
            android:theme="@style/AppTheme.NoActionBar.Tinted" />
        <activity
            android:name="kr.blogspot.charlie0301.wimple.OpenSourceLicensesActivity"
            android:label="@string/opensource_licenses_title"
            android:parentActivityName="kr.blogspot.charlie0301.wimple.WimpleActivity"
            android:theme="@style/AppTheme.NoActionBar" />

        <service
            android:name="kr.blogspot.charlie0301.wimple.BankNotificationListener"
            android:exported="true"
            android:label="@string/bank_noti_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name="kr.blogspot.charlie0301.wimple.MonthlySummaryWidgetProvider"
            android:exported="true"
            android:label="@string/widget_monthly_summary_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_monthly_summary_info" />
        </receiver>

        <service
            android:name="kr.blogspot.charlie0301.wimple.MonthlySummaryWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
    </application>

</manifest>
