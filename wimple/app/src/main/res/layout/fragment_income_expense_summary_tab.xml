<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- refrech button -->

                <ImageView
                    android:id="@+id/ine_refresh"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|top"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="4dp"
                    android:contentDescription="@string/na"
                    android:src="@drawable/refresh" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/entry_header_income_expense_status"
                    android:textColor="@color/md_theme_on_surface_variant"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp">

                    <!-- Incomes -->

                    <View
                        android:id="@+id/ine_bar_income"
                        android:layout_width="60dp"
                        android:layout_height="58dp"
                        android:layout_gravity="center_vertical|left"
                        android:layout_marginLeft="65dp"
                        android:background="@color/md_theme_success_container" />

                    <TextView
                        android:id="@+id/ine_income_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|left"
                        android:layout_marginLeft="80dp"
                        android:paddingLeft="3dp"
                        android:paddingRight="3dp"
                        android:text="..."
                        android:textColor="@color/md_theme_on_success_container"
                        android:textScaleX="0.8"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|left"
                        android:layout_marginLeft="15dp"
                        android:text="@string/entry_header_income"
                        android:textScaleX="0.8"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <!-- Expenses -->

                <View
                    android:id="@+id/ine_bar_expense"
                    android:layout_width="60dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="65dp"
                    android:background="@color/md_theme_error_container" />

                <TextView
                    android:id="@+id/ine_expense_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="80dp"
                    android:paddingLeft="3dp"
                    android:paddingRight="3dp"
                    android:text="..."
                    android:textColor="@color/md_theme_on_error_container"
                    android:textScaleX="0.8"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="15dp"
                    android:text="@string/entry_header_expenses"
                    android:textScaleX="0.8"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- total value -->

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:alpha="0.6"
                    android:contentDescription="@string/na"
                    android:src="@drawable/graph" />

                <TextView
                    android:id="@+id/ine_sum_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="40dp"
                    android:text="..."
                    android:textScaleX="0.8"
                    android:textSize="56sp"
                    app:autoSizeMaxTextSize="56dp"
                    app:autoSizeTextType="uniform" />
            </RelativeLayout>

            <!-- 예산 대비 수익 지출 현황 -->

            <TextView
                android:id="@+id/ine_budget_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|start"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/entry_header_budget_income_expense_status"
                android:textColor="@color/md_theme_on_surface_variant"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- 예산 대비 수익 -->

            <FrameLayout
                android:id="@+id/ine_budget_status_income"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|left"
                android:layout_marginTop="12dp">

                <ImageView
                    android:id="@+id/ine_bar_budget_base_income"
                    android:layout_width="10dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="65dp"
                    android:contentDescription="@string/na"
                    android:scaleType="fitXY"
                    android:src="@drawable/progress_n" />

                <View
                    android:id="@+id/ine_bar_budget_current_income"
                    android:layout_width="60dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="65dp"
                    android:background="@color/md_theme_success_container" />

                <TextView
                    android:id="@+id/ine_bar_budget_current_income_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="80dp"
                    android:paddingLeft="3dp"
                    android:paddingRight="3dp"
                    android:text="..."
                    android:textColor="@color/md_theme_on_success_container"
                    android:textScaleX="0.8"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/ine_income_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="25dp"
                    android:text="@string/title_income"
                    android:textScaleX="0.8"
                    android:textSize="18sp" />
            </FrameLayout>

            <!-- 예산 대비 지출 -->

            <FrameLayout
                android:id="@+id/ine_budget_status_expense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|left"
                android:layout_marginTop="10dp">

                <ImageView
                    android:id="@+id/ine_bar_budget_base_expense"
                    android:layout_width="10dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="65dp"
                    android:contentDescription="@string/na"
                    android:scaleType="fitXY"
                    android:src="@drawable/progress_n" />

                <View
                    android:id="@+id/ine_bar_budget_current_expense"
                    android:layout_width="60dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="65dp"
                    android:background="@color/md_theme_error_container" />

                <TextView
                    android:id="@+id/ine_bar_budget_current_expense_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="80dp"
                    android:paddingLeft="3dp"
                    android:paddingRight="3dp"
                    android:text="..."
                    android:textColor="@color/md_theme_on_error_container"
                    android:textScaleX="0.8"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/ine_expense_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|left"
                    android:layout_marginLeft="25dp"
                    android:text="@string/title_expense"
                    android:textScaleX="0.8"
                    android:textSize="18sp" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <!-- update notification 표시 -->
    <FrameLayout
        android:id="@+id/ine_update_notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/md_theme_secondary_container"
        android:visibility="gone">

        <TextView
            android:id="@+id/ine_list_notification_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="4dp"
            android:textColor="@color/md_theme_on_secondary_container"
            android:textSize="12sp" />
    </FrameLayout>
</RelativeLayout>