<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- State badge (READY / AMBIGUOUS / UNPARSED / classifying / error). The badge text and
         tint are set programmatically per-row from the cached classification. -->
    <TextView
        android:id="@+id/state_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="?attr/colorPrimary" />

    <!-- AI-extracted "거래명 / 금액원" — visible once classification has produced fields.
         When classification is still pending or yielded nothing, this row is hidden. -->
    <TextView
        android:id="@+id/extracted_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- "<좌> ← <우>" suggested account pair, plus a small source tag (learned vs AI). Hidden
         until the cascade resolves to a usable suggestion. -->
    <TextView
        android:id="@+id/account_pair_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="13sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@color/md_theme_outline_variant" />

    <!-- Original notification title (e.g., "[카카오뱅크] 출금"). -->
    <TextView
        android:id="@+id/noti_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="@color/md_theme_on_surface_variant" />

    <TextView
        android:id="@+id/noti_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textColor="@color/md_theme_on_surface_variant" />

    <TextView
        android:id="@+id/noti_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/md_theme_on_surface_variant"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_dismiss"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bank_noti_review_dismiss" />

        <Button
            android:id="@+id/btn_manual_entry"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/bank_noti_review_manual_entry" />

    </LinearLayout>

</LinearLayout>
