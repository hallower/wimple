<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/insert_up_window"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Original notification panel (review-flow only). Hidden by default; the fragment
             unhides it and fills review_notification_text when applyPrefill arrives with
             EXTRA_REVIEW_NOTIFICATION_TEXT. Lets the user verify what the AI extracted
             against the source notification body before confirming. -->
        <LinearLayout
            android:id="@+id/review_notification_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_small"
            android:background="@color/md_theme_surface_variant"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/review_notification_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_on_surface_variant" />

            <TextView
                android:id="@+id/review_notification_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="@color/md_theme_on_surface_variant" />

        </LinearLayout>

        <!-- Date and Amount Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:weightSum="1">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.35"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/insert_yesterday"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/na"
                    android:padding="6dp"
                    android:src="@drawable/ic_action_previous_item" />

                <TextView
                    android:id="@+id/insert_date"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/md_theme_on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/insert_tomorrow"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/na"
                    android:padding="6dp"
                    android:src="@drawable/ic_action_next_item" />
            </LinearLayout>

            <EditText
                android:id="@+id/insert_amount"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_weight="0.65"
                android:background="@drawable/bg_input_field"
                android:gravity="end|center_vertical"
                android:hint="0"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:paddingEnd="@dimen/spacing_large"
                android:paddingStart="@dimen/spacing_large"
                android:textColor="@color/md_theme_primary"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Title and Calculator Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:orientation="horizontal"
            android:weightSum="1">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.35"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_field">

                    <EditText
                        android:id="@+id/insert_entry_title"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:gravity="start|center_vertical"
                        android:hint="@string/insert_item_title"
                        android:inputType="text"
                        android:paddingEnd="40dp"
                        android:paddingStart="@dimen/spacing_medium"
                        android:textColor="@color/md_theme_on_surface"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/insert_title_clear"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="@dimen/spacing_small"
                        android:contentDescription="@string/na"
                        android:src="@drawable/close" />
                </FrameLayout>

                <ListView
                    android:id="@+id/insert_frequent_items"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:divider="@color/md_theme_outline_variant"
                    android:dividerHeight="0.5dp" />
            </LinearLayout>

            <TableLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_weight="0.65"
                android:stretchColumns="0,1,2,3,4">

                <TableRow>
                    <TextView android:id="@+id/insert_pad_7" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="1" android:background="@drawable/button_dark" android:gravity="center" android:text="7" android:textSize="20sp" android:layout_margin="1dp" />
                    <TextView android:id="@+id/insert_pad_8" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="1" android:background="@drawable/button_dark" android:gravity="center" android:text="8" android:textSize="20sp" android:layout_margin="1dp" />
                    <TextView android:id="@+id/insert_pad_9" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="1" android:background="@drawable/button_dark" android:gravity="center" android:text="9" android:textSize="20sp" android:layout_margin="1dp" />
                    <TextView android:id="@+id/insert_pad_back" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="1" android:background="@drawable/button_white" android:gravity="center" android:text="⌫" android:textSize="20sp" android:layout_margin="1dp" />
                    <TextView android:id="@+id/insert_pad_clear" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="1" android:background="@drawable/button_white" android:gravity="center" android:text="C" android:textSize="20sp" android:layout_margin="1dp" />
                </TableRow>

                <TableRow>
                    <TextView android:id="@+id/insert_pad_4" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="1" android:background="@drawable/button_dark" android:gravity="center" android:text="4" android:textSize="20sp" android:layout_margin="1dp" />
                    <TextView android:id="@+id/insert_pad_5" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="1" android:background="@drawable/button_dark" android:gravity="center" android:text="5" android:textSize="20sp" android:layout_margin="1dp" />
                    <TextView android:id="@+id/insert_pad_6" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="1" android:background="@drawable/button_dark" android:gravity="center" android:text="6" android:textSize="20sp" android:layout_margin="1dp" />
                    <TextView android:id="@+id/insert_pad_multiply" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="1" android:background="@drawable/button_white" android:gravity="center" android:text="×" android:textSize="20sp" android:layout_margin="1dp" />
                    <TextView android:id="@+id/insert_pad_divide" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="1" android:background="@drawable/button_white" android:gravity="center" android:text="÷" android:textSize="20sp" android:layout_margin="1dp" />
                </TableRow>

                <TableRow>
                    <TextView android:id="@+id/insert_pad_1" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="1" android:background="@drawable/button_dark" android:gravity="center" android:text="1" android:textSize="20sp" android:layout_margin="1dp" />
                    <TextView android:id="@+id/insert_pad_2" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="1" android:background="@drawable/button_dark" android:gravity="center" android:text="2" android:textSize="20sp" android:layout_margin="1dp" />
                    <TextView android:id="@+id/insert_pad_3" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="1" android:background="@drawable/button_dark" android:gravity="center" android:text="3" android:textSize="20sp" android:layout_margin="1dp" />
                    <TextView android:id="@+id/insert_pad_minus" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="1" android:background="@drawable/button_white" android:gravity="center" android:text="-" android:textSize="20sp" android:layout_margin="1dp" />
                    <TextView android:id="@+id/insert_pad_plus" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="1" android:background="@drawable/button_white" android:gravity="center" android:text="+" android:textSize="20sp" android:layout_margin="1dp" />
                </TableRow>

                <TableRow>
                    <TextView android:id="@+id/insert_pad_10" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="1" android:background="@drawable/button_dark" android:gravity="center" android:text="0" android:textSize="20sp" android:layout_margin="1dp" />
                    <TextView android:id="@+id/insert_pad_point" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="1" android:background="@drawable/button_dark" android:gravity="center" android:text="." android:textSize="20sp" android:layout_margin="1dp" />
                    <TextView android:id="@+id/insert_pad_100" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="1" android:background="@drawable/button_dark" android:gravity="center" android:text="00" android:textSize="20sp" android:layout_margin="1dp" />
                    <TextView android:id="@+id/insert_pad_eq" android:layout_width="0dp" android:layout_height="@dimen/calc_btn_height" android:layout_weight="2" android:layout_span="2" android:background="@color/md_theme_tertiary_container" android:gravity="center" android:text="=" android:textColor="@color/md_theme_on_tertiary_container" android:textSize="20sp" android:layout_margin="1dp" />
                </TableRow>
            </TableLayout>
        </LinearLayout>

        <!-- Memo -->
        <!-- marginTop bumped above the spacing_small baseline so memo + accounts sit ~50dp
             lower than the natural compact layout would put them. Trades vertical screen
             real estate for breathing room above memo (and shifts accounts down with it,
             so accounts is correspondingly shorter). -->
        <LinearLayout
            android:id="@+id/insert_memo_window"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="50dp"
            android:background="@drawable/bg_input_field"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_medium"
                android:paddingEnd="@dimen/spacing_medium"
                android:text="@string/title_memo"
                android:textColor="@color/md_theme_on_surface_variant"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/insert_memo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="@string/description_memo"
                android:paddingStart="@dimen/spacing_small"
                android:paddingEnd="@dimen/spacing_medium"
                android:singleLine="true"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Accounts Selection -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_medium"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="1">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5"
            android:orientation="vertical">

            <TextView
                android:id="@+id/insert_category_left_title"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_header_left"
                android:gravity="center"
                android:text="@string/insert_left_accounts"
                android:textColor="@color/text_red"
                android:textStyle="bold" />

            <ExpandableListView
                android:id="@+id/insert_category_left"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/md_theme_outline_variant"
                android:dividerHeight="0.5dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="0.5"
            android:orientation="vertical">

            <TextView
                android:id="@+id/insert_category_right_title"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_header_right"
                android:gravity="center"
                android:text="@string/insert_right_accounts"
                android:textColor="@color/text_blue"
                android:textStyle="bold" />

            <ExpandableListView
                android:id="@+id/insert_category_right"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/md_theme_outline_variant"
                android:dividerHeight="0.5dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Submit Button -->
    <TextView
        android:id="@+id/btn_submit"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/spacing_medium"
        android:layout_marginBottom="0dp"
        android:background="@drawable/bg_button_submit"
        android:elevation="2dp"
        android:gravity="center"
        android:text="@string/mode_entry_insert"
        android:textColor="@color/text_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/ti_update_notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_secondary_container"
        android:visibility="gone">

        <TextView
            android:id="@+id/ti_list_notification_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="4dp"
            android:textColor="@color/md_theme_on_secondary_container"
            android:textSize="12sp" />
    </FrameLayout>
</LinearLayout>
