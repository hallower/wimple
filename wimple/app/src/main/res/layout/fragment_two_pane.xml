<?xml version="1.0" encoding="utf-8"?>
<!-- Shared two-pane container used by every TwoPaneFragment subclass on
     large screens (sw600dp+). Each pane gets equal weight; a thin divider
     line separates them so the boundary is visible without an explicit
     elevation. The tinted divider color follows the M3 outlineVariant
     attr so it adapts to the active theme without hardcoding gray. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/pane_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="?attr/colorOutlineVariant" />

    <FrameLayout
        android:id="@+id/pane_right"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

</LinearLayout>
