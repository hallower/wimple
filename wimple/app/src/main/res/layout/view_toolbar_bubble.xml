<?xml version="1.0" encoding="utf-8"?>
<!-- Single-line chip-style bubble shown briefly under a freshly-visible toolbar action,
     companion to the icon's shake animation. Width wraps content so the bubble hugs
     whatever short text we pass in (a small count for review queue, a fixed phrase for
     Whooing forum). -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_toolbar_bubble"
    android:elevation="4dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:textColor="@color/md_theme_on_primary"
    android:textSize="12sp"
    android:textStyle="bold"
    android:maxLines="1" />
