<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/md_theme_surface"
        app:titleTextColor="@color/md_theme_on_surface"
        android:theme="@style/ThemeOverlay.Material3.ActionBar"
        app:popupTheme="@style/ThemeOverlay.Material3.Dark" />

    <!-- Dual-use banner: auto-forward to outside.json runs in parallel with this review
         flow when both toggles are on, so the same notification can end up booked twice.
         Visible only while the user has the combination active; tap = jump to settings. -->
    <TextView
        android:id="@+id/dual_use_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:textSize="13sp"
        android:textColor="@android:color/white"
        android:background="#FFEF6C00"
        android:text="@string/bank_noti_review_dual_use_banner"
        android:visibility="gone" />

    <TextView
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/bank_noti_review_empty"
        android:textColor="@color/md_theme_on_surface_variant"
        android:visibility="gone" />

    <ListView
        android:id="@+id/review_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md_theme_surface"
        android:divider="@color/md_theme_outline_variant"
        android:dividerHeight="1dp" />

</LinearLayout>
