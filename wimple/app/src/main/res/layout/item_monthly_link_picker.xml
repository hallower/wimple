<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_list_item_bottom_line"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Row 1: 거래명 + 금액 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/monthly_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/md_theme_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/monthly_item_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/md_theme_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Row 2: 좌측계좌 chip | 우측계좌 chip | 매월 N일 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_item_chip_height"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/monthly_item_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.32"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_header_left"
            android:gravity="center"
            android:textColor="@color/text_red"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/monthly_item_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.32"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_header_right"
            android:gravity="center"
            android:textColor="@color/text_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/monthly_item_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.36"
            android:gravity="end"
            android:textColor="@color/md_theme_on_surface_variant"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
