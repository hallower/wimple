<resources>
    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="nav_header_vertical_spacing">16dp</dimen>
    <dimen name="nav_header_height">171dp</dimen>
    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="activity_horizontal_margin">16dp</dimen>
    <dimen name="activity_vertical_margin">16dp</dimen>
    <dimen name="fab_margin">16dp</dimen>

    <dimen name="calc_btn_height">56dp</dimen>
    <dimen name="card_corner_radius">12dp</dimen>
    <dimen name="button_corner_radius">24dp</dimen>
    <dimen name="spacing_small">4dp</dimen>
    <dimen name="spacing_medium">8dp</dimen>
    <dimen name="spacing_large">16dp</dimen>

    <!-- Shared list-item geometry. Single-row list items across the app (assets/liabilities,
         income/expense, transaction-insert account picker, frequent entries) all anchor on
         these so a future tweak doesn't require touching every layout. -->
    <dimen name="list_item_min_height">48dp</dimen>
    <dimen name="list_item_padding_vertical">8dp</dimen>
    <dimen name="list_item_padding_horizontal">16dp</dimen>
    <!-- Inner chip / title-pill height inside a list-item row (asset name pill, transaction
         L/R account chips). Smaller than the row itself so the row keeps top/bottom padding. -->
    <dimen name="list_item_chip_height">32dp</dimen>
</resources>
