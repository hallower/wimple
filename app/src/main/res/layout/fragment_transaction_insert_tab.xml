<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:paddingLeft="3dp"
    android:paddingRight="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/insert_up_window"
        android:layout_marginBottom="1dp"
        android:orientation="vertical" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:weightSum="1" >

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="0.4"
                android:background="@color/colorPrimary"
                android:gravity="center" >

                <ImageView
                    android:id="@+id/insert_yesterday"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="center"
                    android:contentDescription="@string/na"
                    android:gravity="center"
                    android:paddingBottom="5dp"
                    android:paddingTop="5dp"
                    android:src="@drawable/ic_action_previous_item" />

                <ImageView
                    android:id="@+id/insert_tomorrow"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="center"
                    android:contentDescription="@string/na"
                    android:gravity="center"
                    android:paddingBottom="5dp"
                    android:paddingTop="5dp"
                    android:src="@drawable/ic_action_next_item" />

                <TextView
                    android:id="@+id/insert_date"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@id/insert_tomorrow"
                    android:layout_toEndOf="@id/insert_yesterday"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textColor="@color/text_white"
                    android:textSize="15sp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/insert_amount"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:layout_marginLeft="2dp"
                android:layout_weight="0.6"
                android:background="@color/colorPrimaryDark"
                android:gravity="end|center_vertical"
                android:lines="1"
                android:paddingStart="8dp"
                android:paddingRight="8dp"
                android:textColor="@color/text_white"
                android:textScaleX="0.9"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="1" >

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.4"
                android:orientation="vertical" >

                <FrameLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" >

                    <EditText
                        android:id="@+id/insert_entry_title"
                        android:layout_width="fill_parent"
                        android:layout_height="32dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="@color/colorPrimaryDark"
                        android:gravity="start|center_vertical"
                        android:hint="@string/insert_item_title"
                        android:inputType="text"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/text_light_blue"
                        android:textColorHint="@color/text_white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/insert_title_clear"
                        android:layout_height="28dp"
                        android:layout_gravity="end|center_vertical"
                        android:contentDescription="@string/na"
                        android:src="@drawable/close"
                        android:layout_width="28dp"/>
                </FrameLayout>

                <ListView
                    android:id="@+id/insert_frequent_items"
                    android:layout_width="fill_parent"
                    android:layout_height="150dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:layout_weight="0.6"
                android:orientation="vertical" >

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:stretchColumns="1" >

                    <TableRow>

                        <TextView
                            android:id="@+id/insert_pad_7"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_dark"
                            android:gravity="center"
                            android:text="@string/pad_7"
                            android:textColor="@color/calc_number_btn"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/insert_pad_8"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_dark"
                            android:gravity="center"
                            android:text="@string/pad_8"
                            android:textColor="@color/calc_number_btn"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/insert_pad_9"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_dark"
                            android:gravity="center"
                            android:text="@string/pad_9"
                            android:textColor="@color/calc_number_btn"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/insert_pad_back"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_white"
                            android:gravity="center"
                            android:text="@string/pad_back"
                            android:textColor="@color/calc_func_btn"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/insert_pad_clear"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_white"
                            android:gravity="center"
                            android:text="@string/pad_clear"
                            android:textColor="@color/calc_func_btn"
                            android:textSize="20sp" />
                    </TableRow>

                    <TableRow>

                        <TextView
                            android:id="@+id/insert_pad_4"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_dark"
                            android:gravity="center"
                            android:text="@string/pad_4"
                            android:textColor="@color/calc_number_btn"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/insert_pad_5"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_dark"
                            android:gravity="center"
                            android:text="@string/pad_5"
                            android:textColor="@color/calc_number_btn"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/insert_pad_6"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_dark"
                            android:gravity="center"
                            android:text="@string/pad_6"
                            android:textColor="@color/calc_number_btn"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/insert_pad_multiply"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_white"
                            android:gravity="center"
                            android:text="@string/pad_multiply"
                            android:textColor="@color/calc_func_btn"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/insert_pad_divide"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_white"
                            android:gravity="center"
                            android:text="@string/pad_divide"
                            android:textColor="@color/calc_func_btn"
                            android:textSize="20sp" />
                    </TableRow>

                    <TableRow>

                        <TextView
                            android:id="@+id/insert_pad_1"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_dark"
                            android:gravity="center"
                            android:text="@string/pad_1"
                            android:textColor="@color/calc_number_btn"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/insert_pad_2"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_dark"
                            android:gravity="center"
                            android:text="@string/pad_2"
                            android:textColor="@color/calc_number_btn"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/insert_pad_3"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_dark"
                            android:gravity="center"
                            android:text="@string/pad_3"
                            android:textColor="@color/calc_number_btn"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/insert_pad_minus"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_white"
                            android:gravity="center"
                            android:text="@string/pad_minus"
                            android:textColor="@color/calc_func_btn"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/insert_pad_plus"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_white"
                            android:gravity="center"
                            android:text="@string/pad_plus"
                            android:textColor="@color/calc_func_btn"
                            android:textSize="20sp" />
                    </TableRow>

                    <TableRow>

                        <TextView
                            android:id="@+id/insert_pad_10"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_white"
                            android:gravity="center"
                            android:text="@string/pad_10"
                            android:textColor="@color/calc_func_btn"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/insert_pad_point"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_dark"
                            android:gravity="center"
                            android:text="@string/pad_point"
                            android:textColor="@color/calc_number_btn"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/insert_pad_100"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/button_white"
                            android:gravity="center"
                            android:text="@string/pad_100"
                            android:textColor="@color/calc_func_btn"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/insert_pad_eq"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/calc_btn_height"
                            android:layout_gravity="center"
                            android:layout_span="1"
                            android:layout_weight="2"
                            android:background="@drawable/button_white"
                            android:gravity="center"
                            android:text="@string/pad_eq"
                            android:textColor="@color/calc_func_btn"
                            android:textSize="20sp" />
                    </TableRow>
                </TableLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/insert_memo_window"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@color/colorPrimary"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingRight="8dp"
                android:text="@string/title_memo"
                android:textColor="@color/text_white"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/insert_memo"
                android:layout_width="fill_parent"
                android:layout_height="match_parent"
                android:layout_gravity="bottom"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:hint="@string/description_memo"
                android:maxLength="40"
                android:maxLines="1"
                android:textSize="14sp"
                android:background="@android:color/transparent"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/insert_up_window"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="2dp"
        android:orientation="vertical"
        android:weightSum="1" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="5dp"
            android:layout_weight="0.87"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="1" >

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_weight="0.5"
                android:gravity="top|center_horizontal"
                android:orientation="vertical" >

                <TextView
                    android:id="@+id/insert_category_left_title"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:background="@color/text_red"
                    android:gravity="center"
                    android:text="@string/insert_left_accounts"
                    android:padding="2dp"
                    android:textColor="@color/text_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ExpandableListView
                    android:id="@+id/insert_category_left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_weight="0.5"
                android:gravity="top|center_horizontal"
                android:orientation="vertical" >

                <TextView
                    android:id="@+id/insert_category_right_title"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:background="@color/text_light_blue"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="@string/insert_right_accounts"
                    android:textColor="@color/text_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ExpandableListView
                    android:id="@+id/insert_category_right"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:minHeight="40dp"
            android:layout_weight="0.13"
            android:gravity="center"
            android:text="@string/mode_entry_insert"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ti_update_notification"
        android:layout_width="wrap_content"
        android:layout_height="90dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentTop="true"
        android:layout_gravity="right"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/input_box_round_2"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone" >

        <TextView
            android:id="@+id/ti_list_notification_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="10dp"
            android:text="@string/insert_new_item"
            android:textColor="@color/text_blue" />

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="@string/na"
            android:gravity="center_vertical"
            android:src="@drawable/waiting" />
    </LinearLayout>

</RelativeLayout>