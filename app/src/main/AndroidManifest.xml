<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="kr.blogspot.charlie0301.wimple">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
		<activity
            android:name="kr.blogspot.charlie0301.wimple.SplashScreenActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/title_activity_splash_screen"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <Fragment
            android:name="kr.blogspot.charlie0301.wimple.TransactionInsertFragment"
            android:configChanges="orientation|screenSize"
            android:label="@string/title_transaction_insert_fragment"
            android:windowSoftInputMode="adjustResize" >
        </Fragment>
        <Fragment
            android:name="kr.blogspot.charlie0301.wimple.TransactionListFragment"
            android:configChanges="orientation|screenSize"
            android:label="@string/title_transaction_list_fragment" >
        </Fragment>
        <Fragment
            android:name="kr.blogspot.charlie0301.wimple.SettingsFragment"
            android:label="@string/title_settings_fragment" >
        </Fragment>
		<activity
            android:name="kr.blogspot.charlie0301.wimple.WimpleActivity"
            android:configChanges="orientation|screenSize"
            android:label="@string/title_activity_splash_screen"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar">
        </activity>
        <activity
            android:name="kr.blogspot.charlie0301.wimple.PaymentNoticeActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/title_activity_payment_notice"
            android:theme="@style/FullscreenTheme" >
        </activity>
        <activity
            android:name="kr.blogspot.charlie0301.wimple.PostNewsActivity"
            android:label="@string/title_activity_post_news" >
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/*" />
                <data android:mimeType="plain/*" />
            </intent-filter>
        </activity>
        <receiver android:name="kr.blogspot.charlie0301.wimple.SMSReceiver" >
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>